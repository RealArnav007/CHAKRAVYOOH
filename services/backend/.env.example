# ==========================================
# PUKAR BACKEND — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in values
# ==========================================

ENVIRONMENT=production
PORT=8000
DEBUG=False

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<db>?sslmode=require

# --- Security & Crypto ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<your-64-char-hex-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend X25519 Decryption Private Key (32-byte Hex)
# Generate with: python -c "import nacl.public, nacl.encoding; k=nacl.public.PrivateKey.generate(); print(k.encode(encoder=nacl.encoding.HexEncoder).decode())"
BACKEND_X25519_PRIVATE_KEY=<your-64-char-hex-private-key>

# --- Replay Protection Window (Seconds) ---
REPLAY_WINDOW_SECONDS=300

# --- SMTP / Brevo OTP Settings ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<your-brevo-smtp-login>
SMTP_PASSWORD=<your-brevo-smtp-key>
SMTP_SENDER_EMAIL=<your-sender-email>
MOCK_OTP=False

# --- Groq AI (ML Seam — Handled by Rishabh) ---
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# --- CORS Allowed Origins ---
CORS_ORIGINS=http://localhost:3000,https://pukar-web.vercel.app
